# History (feeds the autosuggestions)
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_dups hist_ignore_space

# Local tools (SSH sessions don't read environment.d)
# .NET itself (DOTNET_ROOT, PATH) is managed by dotnetup in ~/.zshrc
export PATH="$HOME/.local/bin:$HOME/.dotnet/tools:$PATH"
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# Completion with an arrow-key menu, case-insensitive
mkdir -p ~/.zfunc
if command -v gh > /dev/null && [[ ! -f ~/.zfunc/_gh ]]; then
    gh completion -s zsh > ~/.zfunc/_gh
fi
fpath=(~/.zfunc $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# .NET 10 and later ship a native completion script
# Loaded at the first prompt, once dotnetup's lines in ~/.zshrc have put dotnet on PATH
autoload -Uz add-zsh-hook
_dotnet_completion_init() {
    add-zsh-hook -d precmd _dotnet_completion_init
    if command -v dotnet > /dev/null; then
        eval "$(dotnet completions script zsh)"
    fi
}
add-zsh-hook precmd _dotnet_completion_init

# Icons, like Terminal-Icons
if command -v eza > /dev/null; then
    alias ls='eza --icons=auto --group-directories-first'
    alias ll='eza -l --git --icons=auto --group-directories-first'
fi

# Initialize oh-my-posh with custom themes
# You can choose one of the themes below by uncommenting the desired line
# theme=phantom
# theme=kirby
# theme=twilight
# theme=totk
theme=zelda
eval "$(oh-my-posh init zsh --config https://cdn.jsdelivr.net/gh/beauchama/terminal@main/themes/$theme.omp.json)"

# Keep this last (same path on Fedora and Ubuntu)
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
